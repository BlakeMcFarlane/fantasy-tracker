# ---------------------------------------------------------------------------
# ESPN Fantasy Football
# ---------------------------------------------------------------------------
# Required. Found in your league URL:
# https://fantasy.espn.com/football/league?leagueId=THIS_NUMBER&seasonId=2026
ESPN_LEAGUE_ID=

# The fantasy season to load.
ESPN_SEASON_ID=2026

# ---------------------------------------------------------------------------
# Private league credentials (leave blank if the league is public)
# ---------------------------------------------------------------------------
# In a logged-in ESPN tab: DevTools > Application > Cookies > espn.com.
# Copy the values of the `espn_s2` and `SWID` cookies.
# These are SERVER-ONLY. Never prefix them with NEXT_PUBLIC_.
ESPN_S2=
SWID=

# ---------------------------------------------------------------------------
# App behaviour
# ---------------------------------------------------------------------------
# Seconds between ESPN refreshes. 300 = 5 minutes.
LEAGUE_REVALIDATE_SECONDS=300

# Force the built-in demo league instead of ESPN. Handy for previewing the app
# before the league is populated. Shows a visible "Demo data" banner.
# Defaults to on in local development when ESPN_LEAGUE_ID is empty.
USE_MOCK_DATA=

# Which demo scenario to render: "regular" (mid-season) or "preseason".
MOCK_PHASE=regular

# Optional. Adds a link out to the real ESPN league page.
NEXT_PUBLIC_ESPN_LEAGUE_URL=

# ---------------------------------------------------------------------------
# Visitor stats (the unlisted /backdoor/secret page)
# ---------------------------------------------------------------------------
# Long random string used to hash visitor IP + browser into an anonymous id.
# REQUIRED in production: without it, the hashes could be brute-forced back to
# IP addresses. Generate one with: openssl rand -hex 32
ANALYTICS_SALT=

# Optional second lock on the admin page. When set, /backdoor/secret only
# opens with ?key=<this value>; anything else returns a 404.
ADMIN_TOKEN=

# Durable storage for visit history. Without these, production falls back to
# in-memory counts that reset on every deploy. Add a Redis store from the
# Vercel marketplace (Upstash) and these are set for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=
